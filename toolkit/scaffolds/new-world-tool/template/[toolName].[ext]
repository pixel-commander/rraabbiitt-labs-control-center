[typeImport]

/** @param {ToolsProps} props @returns {Promise<ToolReturn>} */
export const run = async (props[inputType])[returnType] => {
  const settings = props;
  /** @type {ToolReturn} */
  let result[resultType];
  try {
    // Add the tool's work here. Set its return_type and extend House types as needed.
    result = { return_type: "results", status: "complete", settings, response: {} };
  } catch (error) {
    result = { return_type: "results", status: "error", settings,
      error: error instanceof Error ? error.message : String(error) };
  }
  // Usage fires once, after the work and before return. No console output.
  try {
    const { finishToolUsage } = await import([usageImport]);
    return await finishToolUsage([id], settings, result);
  } catch (error) {
    return { ...result, error: [result.error,
      `Usage reporting failed: ${error instanceof Error ? error.message : String(error)}`]
      .filter(Boolean).join("\n") };
  }
};
